{
  "name": "cozy-palace",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "npm run dev --workspace=@cozy-palace/frontend",
    "build": "npm run build --workspace=@cozy-palace/frontend",
    "start": "npm run start --workspace=@cozy-palace/frontend",
    "lint": "eslint frontend backend",
    "typecheck": "npm run typecheck --workspace=@cozy-palace/frontend",
    "test": "npm test --workspace=@cozy-palace/frontend",
    "test:integration": "npm test --workspace=@cozy-palace/backend",
    "test:concurrency": "npm run test:concurrency --workspace=@cozy-palace/backend",
    "test:e2e": "npm run test:e2e --workspace=@cozy-palace/frontend",
    "test:e2e:connected": "npm run test:e2e:connected --workspace=@cozy-palace/frontend"
  },
  "devDependencies": {
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2"
  }
}
