NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never put service-role/database passwords in NEXT_PUBLIC_ variables.

# Trusted app origin for confirmation and recovery emails (set exact Vercel URL there).
SITE_URL=http://localhost:3000

# Online payment (Xendit hosted invoice). Leave empty to keep checkout disabled.
# Use xnd_development_ keys locally and on Preview (test mode, no real money); xnd_production_ is ignored outside Vercel Production.
XENDIT_SECRET_KEY=
# Webhook verification token from Xendit Dashboard > Settings > Webhooks. Set the Invoices "paid" URL to <site>/api/xendit/webhook.
XENDIT_WEBHOOK_TOKEN=
# Supabase secret key: server-only. Records webhook payments and runs bookings for visitors without an account.
# Leave empty to keep "Choose room" sending signed-out visitors to sign in.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile CAPTCHA for booking without an account. Booking without an account stays off unless both are set.
# Local testing: 1x00000000000000000000AA (site) and 1x0000000000000000000000000000000AA (secret) always pass.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated frontend hostnames whose tokens this deployment accepts (no localhost in Production),
# e.g. cozy-palace-six.vercel.app. Required with a real secret; ignored with the test keys above.
TURNSTILE_HOSTNAMES=
# Gmail account that emails visitors without an account their booking details. Optional; without it they only see the reference on screen.
# Turn on 2-Step Verification for the account, then create an app password at https://myaccount.google.com/apppasswords
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Random string (16+ characters). Vercel sends it to /api/notifications/run, the daily reminder and email-retry job.
CRON_SECRET=
