NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Never put service-role/database passwords in NEXT_PUBLIC_ variables.

# Trusted app origin for confirmation and recovery emails (set exact Vercel URL there).
SITE_URL=http://localhost:3000

# Online payment (PayMongo hosted checkout). Leave empty to keep checkout disabled.
# Use sk_test_ keys locally and on Preview; sk_live_ is ignored outside Vercel Production.
PAYMONGO_SECRET_KEY=
# Secret of the PayMongo webhook pointing at <site>/api/paymongo/webhook (event: checkout_session.payment.paid).
PAYMONGO_WEBHOOK_SECRET=
# Supabase secret key: server-only. Records webhook payments and runs bookings for visitors without an account.
# Leave empty to keep "Choose room" sending signed-out visitors to sign in.
SUPABASE_SECRET_KEY=

# Cloudflare Turnstile CAPTCHA for booking without an account. Booking without an account stays off unless both are set.
# Local testing: 1x00000000000000000000AA (site) and 1x0000000000000000000000000000000AA (secret) always pass.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Resend, for emailing visitors without an account their booking details. Optional; without it they only see the reference on screen.
# Without a verified domain, Resend only delivers to your own account email (use onboarding@resend.dev as sender).
RESEND_API_KEY=
EMAIL_FROM=
